```python
"""
Offer Letter Controller Module
Replacement for Excel-based offer letter management with secure database operations
"""

from datetime import datetime, date, timedelta
from typing import Dict, List, Optional, Any, Union
from fastapi import HTTPException, status, Depends
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, and_, or_, func, text
from sqlalchemy.orm import selectinload
from pydantic import BaseModel, Field, validator
from decimal import Decimal
import json
import logging
import uuid
from enum import Enum

from app.database import get_db
from app.models.customer import Customer, AccountType, CustomerStatus
from app.models.facility import Facility, FacilityType, FacilityStatus
from app.utils.security import get_current_user, TokenData

logger = logging.getLogger(__name__)


class OfferLetterStatus(str, Enum):
    DRAFT = "draft"
    PENDING_APPROVAL = "pending_approval"
    APPROVED = "approved"
    REJECTED = "rejected"
    SENT = "sent"
    ACCEPTED = "accepted"
    EXPIRED = "expired"
    CANCELLED = "cancelled"


class OfferLetterType(str, Enum):
    NEW_FACILITY = "new_facility"
    RENEWAL = "renewal"
    ENHANCEMENT = "enhancement"
    RESTRUCTURE = "restructure"
    AMENDMENT = "amendment"


class DocumentType(str, Enum):
    OFFER_LETTER = "offer_letter"
    TERMS_CONDITIONS = "terms_conditions"
    SECURITY_DOCUMENTS = "security_documents"
    APPROVAL_MEMO = "approval_memo"
    CUSTOMER_ACCEPTANCE = "customer_acceptance"


class ApprovalLevel(str, Enum):
    RELATIONSHIP_MANAGER = "relationship_manager"
    BRANCH_MANAGER = "branch_manager"
    CREDIT_MANAGER = "credit_manager"
    REGIONAL_MANAGER = "regional_manager"
    HEAD_OFFICE = "head_office"


class OfferLetterTemplate(BaseModel):
    """Template for offer letter generation"""
    template_id: str
    template_name: str
    facility_type: FacilityType
    template_content: str
    variables: Dict[str, Any]
    is_active: bool = True
    created_at: datetime = Field(default_factory=datetime.utcnow)


class OfferLetterCreate(BaseModel):
    """Schema for creating offer letter"""
    customer_id: str = Field(..., min_length=1, max_length=50)
    facility_id: Optional[str] = Field(None, max_length=50)
    offer_type: OfferLetterType
    facility_type: FacilityType
    proposed_amount: Decimal = Field(..., gt=0, decimal_places=2)
    currency: str = Field(default="AED", max_length=10)
    proposed_rate: Optional[Decimal] = Field(None, ge=0, decimal_places=3)
    tenor_months: Optional[int] = Field(None, ge=1, le=360)
    security_details: Optional[str] = Field(None, max_length=2000)
    special_conditions: Optional[str] = Field(None, max_length=2000)
    expiry_date: date = Field(..., description="Offer validity date")
    template_id: Optional[str] = Field(None, max_length=50)
    notes: Optional[str] = Field(None, max_length=1000)

    @validator('expiry_date')
    def validate_expiry_date(cls, v):
        if v <= date.today():
            raise ValueError('Expiry date must be in the future')
        if v > date.today() + timedelta(days=90):
            raise ValueError('Expiry date cannot be more than 90 days in the future')
        return v


class OfferLetterUpdate(BaseModel):
    """Schema for updating offer letter"""
    proposed_amount: Optional[Decimal] = Field(None, gt=0, decimal_places=2)
    proposed_rate: Optional[Decimal] = Field(None, ge=0, decimal_places=3)
    tenor_months: Optional[int] = Field(None, ge=1, le=360)
    security_details: Optional[str] = Field(None, max_length=2000)
    special_conditions: Optional[str] = Field(None, max_length=2000)
    expiry_date: Optional[date] = None
    notes: Optional[str] = Field(None, max_length=1000)

    @validator('expiry_date')
    def validate_expiry_date(cls, v):
        if v and v <= date.today():
            raise ValueError('Expiry date must be in the future')
        return v


class ApprovalAction(BaseModel):
    """Schema for approval actions"""
    action: str = Field(..., regex="^(approve|reject|return)$")
    comments: Optional[str] = Field(None, max_length=1000)
    conditions: Optional[str] = Field(None, max_length=2000)


class OfferLetterResponse(BaseModel):
    """Response schema for offer letter"""
    id: str
    offer_number: str
    customer_id: str
    customer_name: Optional[str]
    facility_id: Optional[str]
    offer_type: OfferLetterType
    facility_type: FacilityType
    status: OfferLetterStatus
    proposed_amount: Decimal
    currency: str
    proposed_rate: Optional[Decimal]
    tenor_months: Optional[int]
    security_details: Optional[str]
    special_conditions: Optional[str]
    expiry_date: date
    generated_date: datetime
    approved_date: Optional[datetime]
    sent_date: Optional[datetime]
    accepted_date: Optional[datetime]
    created_by: str
    approved_by: Optional[str]
    current_approval_level: Optional[ApprovalLevel]
    notes: Optional[str]
    created_at: datetime
    updated_at: Optional[datetime]

    class Config:
        from_attributes = True


class OfferLetterController:
    """Controller for offer letter management operations"""

    def __init__(self, db: AsyncSession):
        self.db = db

    async def create_offer_letter(
        self, 
        offer_data: OfferLetterCreate, 
        current_user: TokenData
    ) -> Dict[str, Any]:
        """Create new offer letter"""
        try:
            # Verify customer exists
            customer_query = select(Customer).where(
                and_(
                    Customer.id == offer_data.customer_id,
                    Customer.is_deleted == False
                )
            )
            customer_result = await self.db.execute(customer_query)
            customer = customer_result.scalar_one_or_none()

            if not customer:
                raise HTTPException(
                    status_code=status.HTTP_404_NOT_FOUND,
                    detail="Customer not found"
                )

            # Verify facility if provided
            facility = None
            if offer_data.facility_id:
                facility_query = select(Facility).where(
                    and_(
                        Facility.id == offer_data.facility_id,
                        Facility.customer_id == offer_data.customer_id,
                        Facility.is_deleted == False
                    )
                )
                facility_result = await self.db.execute(facility_query)
                facility = facility_result.scalar_one_or_none()

                if not facility:
                    raise HTTPException(
                        status_code=status.HTTP_404_NOT_FOUND,
                        detail="Facility not found for this customer"
                    )

            # Generate offer number
            offer_number = await self._generate_offer_number()

            # Create offer letter record
            offer_letter_data = {
                "id": str(uuid.uuid4())[:8].upper(),
                "offer_number": offer_number,
                "customer_id": offer_data.customer_id,
                "facility_id": offer_data.facility_id,
                "offer_type": offer_data.offer_type,
                "facility_type": offer_data.facility_type,
                "status": OfferLetterStatus.DRAFT,
                "proposed_amount": offer_data.proposed_amount,
                "currency": offer_data.currency,
                "proposed_rate": offer_data.proposed_rate,
                "tenor_months": offer_data.tenor_months,
                "security_details": offer_data.security_details,
                "special_conditions": offer_data.special_conditions,
                "expiry_date": offer_data.expiry_date,
                "generated_date": datetime.utcnow(),
                "created_by": current_user.user_id,
                "current_approval_level": ApprovalLevel.RELATIONSHIP_MANAGER,
                "notes": offer_data.notes,
                "created_at": datetime.utcnow()
            }

            # Insert into database (would need actual OfferLetter model)
            insert_query = text("""
                INSERT INTO offer_letters (
                    id, offer_number, customer_id, facility_id, offer_type, 
                    facility_type, status, proposed_amount, currency, proposed_rate,
                    tenor_months, security_details, special_conditions, expiry_date,
                    generated_date, created_by, current_approval_level, notes, created_at
                ) VALUES (
                    :id, :offer_number, :customer_id, :facility_id, :offer_type,
                    :facility_type, :status, :proposed_amount, :currency, :proposed_rate,
                    :tenor_months, :security_details, :special_conditions, :expiry_date,
                    :generated_date, :created_by, :current_approval_level, :notes, :created_at
                )
            """)

            await self.db.execute(insert_query, offer_letter_data)
            await self.db.commit()

            # Log offer letter creation
            logger.info(f"Offer letter {offer_number} created by {current_user.user_id}")

            return {
                "id": offer_letter_data["id"],
                "offer_number": offer_number,
                "status": OfferLetterStatus.DRAFT,
                "message": "Offer letter created successfully"
            }

        except HTTPException:
            raise
        except Exception as e:
            await self.db.rollback()
            logger.error(f"Failed to create offer letter: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Failed to create offer letter"
            )

    async def get_offer_letters(
        self,
        customer_id: Optional[str] = None,
        status: Optional[OfferLetterStatus] = None,
        offer_type: Optional[OfferLetterType] = None,
        date_from: Optional[date] = None,
        date_to: Optional[date] = None,
        skip: int = 0,
        limit: int = 100,
        current_user: TokenData = None
    ) -> Dict[str, Any]:
        """Get offer letters with filtering"""
        try:
            # Build base query
            base_query = """
                SELECT ol.*, c.name as customer_name, c.account_no
                FROM offer_letters ol
                JOIN customers c ON ol.customer_id = c.id
                WHERE ol.is_deleted = FALSE AND c.is_deleted = FALSE
            """
            
            params = {}
            conditions = []

            # Apply filters
            if customer_id:
                conditions.append("ol.customer_id = :customer_id")
                params["customer_id"] = customer_id

            if status:
                conditions.append("ol.status = :status")
                params["status"] = status.value

            if offer_type:
                conditions.append("ol.offer_type = :offer_type")
                params["offer_type"] = offer_type.value

            if date_from:
                conditions.append("ol.generated_date >= :date_from")
                params["date_from"] = date_from

            if date_to:
                conditions.append("ol.generated_date <= :date_to")
                params["date_to"] = date_to

            if conditions:
                base_query += " AND " + " AND ".join(conditions)

            # Get total count
            count_query = f"SELECT COUNT(*) FROM ({base_query}) as counted"
            count_result = await self.db.execute(text(count_query), params)
            total = count_result.scalar() or 0

            # Apply pagination and ordering
            query = f"{base_query} ORDER BY ol.generated_date DESC LIMIT :limit OFFSET :skip"
            params.update({"limit": limit, "skip": skip})

            result = await self.db.execute(text(query), params)
            offer_letters = [dict(row._mapping) for row in result.fetchall()]

            return {
                "items": offer_letters,
                "total": total,
                "page": (skip // limit) + 1,
                "page_size": limit,
                "pages": (total + limit - 1) // limit
            }

        except Exception as e:
            logger.error(f"Failed to retrieve offer letters: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Failed to retrieve offer letters"
            )

    async def get_offer_letter(
        self, 
        offer_id: str, 
        current_user: TokenData
    ) -> Dict[str, Any]:
        """Get specific offer letter"""
        try:
            query = text("""
                SELECT ol.*, c.name as customer_name, c.account_no,
                       f.name as facility_name
                FROM offer_letters ol
                JOIN customers c ON ol.customer_id = c.id
                LEFT JOIN facilities f ON ol.facility_id = f.id
                WHERE ol.id = :offer_id AND ol.is_deleted = FALSE
            """)

            result = await self.db.execute(query, {"offer_id": offer_id})
            offer_letter = result.fetchone()

            if not offer_letter:
                raise HTTPException(
                    status_code=status.HTTP_404_NOT_FOUND,
                    detail="Offer letter not found"
                )

            return dict(offer_letter._mapping)

        except HTTPException:
            raise
        except Exception as e:
            logger.error(f"Failed to retrieve offer letter {offer_id}: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Failed to retrieve offer letter"
            )

    async def update_offer_letter(
        self,
        offer_id: str,
        update_data: OfferLetterUpdate,
        current_user: TokenData
    ) -> Dict[str, Any]:
        """Update offer letter"""
        try:
            # Check if offer letter exists and is editable
            check_query = text("""
                SELECT status, created_by FROM offer_letters 
                WHERE id = :offer_id AND is_deleted = FALSE
            """)
            result = await self.db.execute(check_query, {"offer_id": offer_id})
            offer_info = result.fetchone()

            if not offer_info:
                raise HTTPException(
                    status_code=status.HTTP_404_NOT_FOUND,
                    detail="Offer letter not found"
                )

            # Check if offer letter can be edited
            if offer_info.status not in [OfferLetterStatus.DRAFT, OfferLetterStatus.REJECTED]:
                raise HTTPException(
                    status_code=status.HTTP_400_BAD_REQUEST,
                    detail="Offer letter cannot be edited in current status"
                )

            # Build update query
            update_fields = []
            params = {"offer_id": offer_id, "updated_at": datetime.utcnow()}

            update_data_dict = update_data.model_dump(exclude_unset=True)
            for field, value in update_data_dict.items():
                if value is not None:
                    update_fields.append(f"{field} = :{field}")
                    params[field] = value

            if not update_fields: