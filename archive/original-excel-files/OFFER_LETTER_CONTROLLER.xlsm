"""
Secure Banking Data Management System
Replaces Excel-based OFFER_LETTER_CONTROLLER with secure database operations
"""

from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any, Union
from fastapi import HTTPException, status, Depends
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, and_, or_, func, text
from cryptography.fernet import Fernet
import json
import logging
import hashlib
import secrets
import uuid
from enum import Enum
from decimal import Decimal
import asyncio
from pathlib import Path

from app.database import get_db
from app.models.customer import Customer, AccountType, CustomerStatus
from app.models.facility import Facility, FacilityType, FacilityStatus
from app.models.user import User
from app.utils.security import get_current_user, TokenData
from app.config import settings

logger = logging.getLogger(__name__)


class DataClassification(str, Enum):
    """Data classification levels for banking information"""
    PUBLIC = "public"
    INTERNAL = "internal"
    CONFIDENTIAL = "confidential"
    RESTRICTED = "restricted"


class OfferLetterStatus(str, Enum):
    """Offer letter processing status"""
    DRAFT = "draft"
    PENDING_APPROVAL = "pending_approval"
    APPROVED = "approved"
    REJECTED = "rejected"
    SENT = "sent"
    ACCEPTED = "accepted"
    EXPIRED = "expired"


class SecureEncryptionService:
    """Enhanced encryption service for banking data"""
    
    def __init__(self, encryption_key: Optional[str] = None):
        if encryption_key:
            self.cipher = Fernet(encryption_key.encode())
        else:
            # Use environment key or generate secure session key
            env_key = getattr(settings, 'ENCRYPTION_KEY', None)
            if env_key:
                self.cipher = Fernet(env_key.encode())
            else:
                key = Fernet.generate_key()
                self.cipher = Fernet(key)
                logger.warning("Using session-based encryption key. Set ENCRYPTION_KEY in production.")
    
    def encrypt_sensitive_data(self, data: Union[str, Dict, List]) -> str:
        """Encrypt sensitive banking data with validation"""
        try:
            if isinstance(data, (dict, list)):
                data_str = json.dumps(data, ensure_ascii=False, default=str)
            else:
                data_str = str(data)
            
            # Add timestamp and checksum for integrity
            payload = {
                "data": data_str,
                "timestamp": datetime.utcnow().isoformat(),
                "checksum": hashlib.sha256(data_str.encode()).hexdigest()
            }
            
            encrypted = self.cipher.encrypt(json.dumps(payload).encode()).decode()
            return encrypted
            
        except Exception as e:
            logger.error(f"Encryption failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Data encryption failed"
            )
    
    def decrypt_sensitive_data(self, encrypted_data: str) -> Any:
        """Decrypt and validate sensitive banking data"""
        try:
            decrypted_bytes = self.cipher.decrypt(encrypted_data.encode())
            payload = json.loads(decrypted_bytes.decode())
            
            # Validate payload structure
            if not all(key in payload for key in ["data", "timestamp", "checksum"]):
                raise ValueError("Invalid payload structure")
            
            # Verify checksum
            data_str = payload["data"]
            expected_checksum = hashlib.sha256(data_str.encode()).hexdigest()
            if payload["checksum"] != expected_checksum:
                raise ValueError("Data integrity check failed")
            
            # Check if data is not too old (optional security measure)
            timestamp = datetime.fromisoformat(payload["timestamp"])
            age = datetime.utcnow() - timestamp
            if age > timedelta(hours=24):
                logger.warning(f"Decrypting old data: {age}")
            
            return data_str
            
        except Exception as e:
            logger.error(f"Decryption failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Data decryption failed"
            )


class SecureAuditLogger:
    """Enhanced audit logging for banking operations with compliance features"""
    
    @staticmethod
    async def log_banking_operation(
        user_id: str,
        operation: str,
        resource_type: str,
        resource_id: str,
        data_classification: DataClassification,
        db: AsyncSession,
        operation_details: Optional[Dict] = None,
        client_info: Optional[Dict] = None
    ):
        """Log banking operations with comprehensive audit trail"""
        
        audit_entry = {
            "audit_id": str(uuid.uuid4()),
            "timestamp": datetime.utcnow().isoformat(),
            "user_id": user_id,
            "operation": operation,
            "resource_type": resource_type,
            "resource_id": resource_id,
            "data_classification": data_classification.value,
            "operation_details": operation_details or {},
            "client_info": {
                "ip_address": client_info.get("ip_address") if client_info else None,
                "user_agent": client_info.get("user_agent") if client_info else None,
                "session_id": client_info.get("session_id") if client_info else None
            },
            "compliance_flags": {
                "pci_dss": data_classification in [DataClassification.CONFIDENTIAL, DataClassification.RESTRICTED],
                "gdpr_relevant": "customer_data" in resource_type,
                "sox_compliance": operation in ["CREATE", "UPDATE", "DELETE"]
            }
        }
        
        # Store in secure audit table (would be implemented)
        logger.info(f"AUDIT_BANKING: {json.dumps(audit_entry)}")
        
        # For high-risk operations, send to SIEM
        if data_classification == DataClassification.RESTRICTED:
            await SecureAuditLogger._send_to_siem(audit_entry)
    
    @staticmethod
    async def _send_to_siem(audit_entry: Dict):
        """Send critical audit events to SIEM system"""
        # Implementation would send to actual SIEM
        logger.critical(f"SIEM_ALERT: {json.dumps(audit_entry)}")


class SecureOfferLetterController:
    """Secure replacement for Excel-based offer letter management"""
    
    def __init__(self, db: AsyncSession, current_user: TokenData):
        self.db = db
        self.current_user = current_user
        self.encryption = SecureEncryptionService()
    
    async def create_offer_letter(
        self,
        customer_id: str,
        facility_data: Dict[str, Any],
        terms_conditions: Dict[str, Any],
        approval_workflow: Optional[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        """Create secure offer letter with encrypted sensitive data"""
        
        try:
            # Validate customer exists and user has access
            customer = await self._validate_customer_access(customer_id)
            
            # Encrypt sensitive financial terms
            encrypted_terms = self.encryption.encrypt_sensitive_data({
                "facility_data": facility_data,
                "terms_conditions": terms_conditions,
                "created_by": self.current_user.user_id,
                "created_at": datetime.utcnow().isoformat()
            })
            
            # Create offer letter record
            offer_letter_id = f"OL{secrets.token_hex(6).upper()}"
            
            offer_letter = {
                "id": offer_letter_id,
                "customer_id": customer_id,
                "status": OfferLetterStatus.DRAFT,
                "encrypted_data": encrypted_terms,
                "data_classification": DataClassification.RESTRICTED.value,
                "created_by": self.current_user.user_id,
                "created_at": datetime.utcnow(),
                "expires_at": datetime.utcnow() + timedelta(days=30),
                "approval_required": approval_workflow is not None
            }
            
            # Log the creation
            await SecureAuditLogger.log_banking_operation(
                user_id=self.current_user.user_id,
                operation="CREATE_OFFER_LETTER",
                resource_type="offer_letter",
                resource_id=offer_letter_id,
                data_classification=DataClassification.RESTRICTED,
                db=self.db,
                operation_details={
                    "customer_id": customer_id,
                    "facility_type": facility_data.get("facility_type"),
                    "amount": str(facility_data.get("amount", 0))
                }
            )
            
            return {
                "offer_letter_id": offer_letter_id,
                "status": offer_letter["status"],
                "customer_name": customer.name,
                "expires_at": offer_letter["expires_at"].isoformat(),
                "created_at": offer_letter["created_at"].isoformat()
            }
            
        except Exception as e:
            logger.error(f"Offer letter creation failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Offer letter creation failed"
            )
    
    async def generate_offer_document(
        self,
        offer_letter_id: str,
        template_type: str = "standard"
    ) -> Dict[str, Any]:
        """Generate secure offer letter document"""
        
        try:
            # Retrieve and decrypt offer data
            offer_data = await self._get_offer_letter(offer_letter_id)
            decrypted_data = json.loads(
                self.encryption.decrypt_sensitive_data(offer_data["encrypted_data"])
            )
            
            # Generate document content
            document_content = await self._generate_document_content(
                decrypted_data, template_type
            )
            
            # Create secure document ID
            document_id = f"DOC{secrets.token_hex(8).upper()}"
            
            # Encrypt document content
            encrypted_document = self.encryption.encrypt_sensitive_data(document_content)
            
            document_record = {
                "document_id": document_id,
                "offer_letter_id": offer_letter_id,
                "template_type": template_type,
                "encrypted_content": encrypted_document,
                "generated_by": self.current_user.user_id,
                "generated_at": datetime.utcnow(),
                "digital_signature": await self._generate_digital_signature(document_content)
            }
            
            # Log document generation
            await SecureAuditLogger.log_banking_operation(
                user_id=self.current_user.user_id,
                operation="GENERATE_DOCUMENT",
                resource_type="offer_document",
                resource_id=document_id,
                data_classification=DataClassification.RESTRICTED,
                db=self.db,
                operation_details={
                    "offer_letter_id": offer_letter_id,
                    "template_type": template_type
                }
            )
            
            return {
                "document_id": document_id,
                "offer_letter_id": offer_letter_id,
                "status": "generated",
                "generated_at": document_record["generated_at"].isoformat(),
                "digital_signature": document_record["digital_signature"]
            }
            
        except Exception as e:
            logger.error(f"Document generation failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Document generation failed"
            )
    
    async def submit_for_approval(
        self,
        offer_letter_id: str,
        approver_ids: List[str],
        approval_notes: Optional[str] = None
    ) -> Dict[str, Any]:
        """Submit offer letter for approval workflow"""
        
        try:
            offer_data = await self._get_offer_letter(offer_letter_id)
            
            # Validate user can submit for approval
            if offer_data["created_by"] != self.current_user.user_id:
                raise HTTPException(
                    status_code=status.HTTP_403_FORBIDDEN,
                    detail="Only creator can submit for approval"
                )
            
            # Create approval workflow
            approval_id = f"APR{secrets.token_hex(6).upper()}"
            
            approval_workflow = {
                "approval_id": approval_id,
                "offer_letter_id": offer_letter_id,
                "approver_ids": approver_ids,
                "status": "pending",
                "submitted_by": self.current_user.user_id,
                "submitted_at": datetime.utcnow(),
                "approval_notes": approval_notes,
                "approvals_required": len(approver_ids),
                "approvals_received": 0
            }
            
            # Update offer letter status
            await self._update_offer_status(offer_letter_id, OfferLetterStatus.PENDING_APPROVAL)
            
            # Send notifications to approvers (would be implemented)
            await self._notify_approvers(approver_ids, offer_letter_id)
            
            # Log submission
            await SecureAuditLogger.log_banking_operation(
                user_id=self.current_user.user_id,
                operation="SUBMIT_APPROVAL",
                resource_type="offer_letter_approval",
                resource_id=approval_id,
                data_classification=DataClassification.RESTRICTED,
                db=self.db,
                operation_details={
                    "offer_letter_id": offer_letter_id,
                    "approver_count": len(approver_ids)
                }
            )
            
            return {
                "approval_id": approval_id,
                "status": "submitted",
                "approvers": len(approver_ids),
                "submitted_at": approval_workflow["submitted_at"].isoformat()
            }
            
        except Exception as e:
            logger.error(f"Approval submission failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Approval submission failed"
            )
    
    async def process_approval(
        self,
        approval_id: str,
        decision: str,  # "approve" or "reject"
        comments: Optional[str] = None
    ) -> Dict[str, Any]:
        """Process approval decision"""
        
        try:
            if decision not in ["approve", "reject"]:
                raise HTTPException(
                    status_code=status.HTTP_400_BAD_REQUEST,
                    detail="Decision must be 'approve' or 'reject'"
                )
            
            # Get approval workflow
            approval_data = await self._get_approval_workflow(approval_id)
            
            # Validate user is an approver
            if self.current_user.user_id not in approval_data["approver_ids"]:
                raise HTTPException(
                    status_code=status.HTTP_403_FORBIDDEN,
                    detail="User not authorized to approve this offer"
                )
            
            # Record approval decision
            approval_decision = {
                "approver_id": self.current_user.user_id,
                "decision": decision,
                "comments": comments,
                "decided_at": datetime.utcnow()
            }
            
            # Update approval workflow
            if decision == "approve":
                approval_data["approvals_received"] += 1
                
                # Check if all approvals received
                if approval_data["approvals_received"] >= approval_data["approvals_required"]:
                    await self._update_offer_status(
                        approval_data["offer_letter_id"], 
                        OfferLetterStatus.APPROVED
                    )
                    final_status = "fully_approved"
                else: