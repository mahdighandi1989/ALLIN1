"""
Security Enhancement Module for Banking Data Management
Replaces Excel-based data handling with secure database operations
"""

from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any
from fastapi import HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, and_, or_, func
from cryptography.fernet import Fernet
import json
import logging
import hashlib
import secrets
from enum import Enum

from app.database import get_db
from app.models.customer import Customer
from app.models.facility import Facility
from app.utils.security import get_current_user

logger = logging.getLogger(__name__)

class DataClassification(str, Enum):
    PUBLIC = "public"
    INTERNAL = "internal"
    CONFIDENTIAL = "confidential"
    RESTRICTED = "restricted"

class EncryptionService:
    """Secure encryption service for sensitive banking data"""
    
    def __init__(self, encryption_key: Optional[str] = None):
        if encryption_key:
            self.cipher = Fernet(encryption_key.encode())
        else:
            # Generate a new key for this session
            key = Fernet.generate_key()
            self.cipher = Fernet(key)
            logger.warning("Using session-based encryption key. Set ENCRYPTION_KEY in production.")
    
    def encrypt_data(self, data: str) -> str:
        """Encrypt sensitive data"""
        try:
            return self.cipher.encrypt(data.encode()).decode()
        except Exception as e:
            logger.error(f"Encryption failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Data encryption failed"
            )
    
    def decrypt_data(self, encrypted_data: str) -> str:
        """Decrypt sensitive data"""
        try:
            return self.cipher.decrypt(encrypted_data.encode()).decode()
        except Exception as e:
            logger.error(f"Decryption failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Data decryption failed"
            )

class AuditLogger:
    """Secure audit logging for banking operations"""
    
    @staticmethod
    async def log_access(
        user_id: str,
        action: str,
        resource_type: str,
        resource_id: str,
        data_classification: DataClassification,
        db: AsyncSession,
        additional_info: Optional[Dict] = None
    ):
        """Log access to sensitive banking data"""
        audit_entry = {
            "timestamp": datetime.utcnow().isoformat(),
            "user_id": user_id,
            "action": action,
            "resource_type": resource_type,
            "resource_id": resource_id,
            "data_classification": data_classification.value,
            "ip_address": additional_info.get("ip_address") if additional_info else None,
            "user_agent": additional_info.get("user_agent") if additional_info else None,
            "session_id": additional_info.get("session_id") if additional_info else None
        }
        
        # In production, this should be sent to a secure audit system
        logger.info(f"AUDIT: {json.dumps(audit_entry)}")

class SecureDataManager:
    """Secure replacement for Excel-based data management"""
    
    def __init__(self, db: AsyncSession, encryption_service: EncryptionService):
        self.db = db
        self.encryption = encryption_service
    
    async def secure_customer_export(
        self,
        user_id: str,
        filters: Optional[Dict] = None,
        include_sensitive: bool = False
    ) -> Dict[str, Any]:
        """Securely export customer data with proper access controls"""
        
        # Log access attempt
        await AuditLogger.log_access(
            user_id=user_id,
            action="EXPORT_CUSTOMERS",
            resource_type="customer_data",
            resource_id="bulk_export",
            data_classification=DataClassification.CONFIDENTIAL
        )
        
        try:
            # Build secure query with filters
            query = select(Customer).where(Customer.is_deleted == False)
            
            if filters:
                if filters.get("account_type"):
                    query = query.where(Customer.account_type == filters["account_type"])
                if filters.get("branch"):
                    query = query.where(Customer.branch == filters["branch"])
                if filters.get("status"):
                    query = query.where(Customer.status == filters["status"])
            
            result = await self.db.execute(query)
            customers = result.scalars().all()
            
            # Sanitize data based on access level
            sanitized_data = []
            for customer in customers:
                customer_data = {
                    "id": customer.id,
                    "account_no": customer.account_no,
                    "name": customer.name,
                    "account_type": customer.account_type.value,
                    "status": customer.status.value,
                    "branch": customer.branch,
                    "created_at": customer.created_at.isoformat() if customer.created_at else None
                }
                
                # Include sensitive data only if authorized
                if include_sensitive:
                    customer_data.update({
                        "email": customer.email,
                        "phone": customer.phone,
                        "mobile": customer.mobile,
                        "address": customer.address
                    })
                else:
                    # Mask sensitive information
                    customer_data.update({
                        "email": self._mask_email(customer.email) if customer.email else None,
                        "phone": self._mask_phone(customer.phone) if customer.phone else None
                    })
                
                sanitized_data.append(customer_data)
            
            return {
                "data": sanitized_data,
                "total_records": len(sanitized_data),
                "export_timestamp": datetime.utcnow().isoformat(),
                "data_classification": DataClassification.CONFIDENTIAL.value,
                "includes_sensitive_data": include_sensitive
            }
            
        except Exception as e:
            logger.error(f"Secure export failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Secure data export failed"
            )
    
    async def secure_facility_report(
        self,
        user_id: str,
        date_from: Optional[datetime] = None,
        date_to: Optional[datetime] = None,
        facility_types: Optional[List[str]] = None
    ) -> Dict[str, Any]:
        """Generate secure facility reports with encryption"""
        
        await AuditLogger.log_access(
            user_id=user_id,
            action="GENERATE_FACILITY_REPORT",
            resource_type="facility_data",
            resource_id="bulk_report",
            data_classification=DataClassification.RESTRICTED
        )
        
        try:
            # Build query with date and type filters
            query = select(Facility).where(Facility.is_deleted == False)
            
            if date_from:
                query = query.where(Facility.created_at >= date_from)
            if date_to:
                query = query.where(Facility.created_at <= date_to)
            if facility_types:
                query = query.where(Facility.facility_type.in_(facility_types))
            
            result = await self.db.execute(query)
            facilities = result.scalars().all()
            
            # Calculate aggregated metrics
            total_amount = sum(float(f.amount) for f in facilities if f.amount)
            total_outstanding = sum(float(f.outstanding) for f in facilities if f.outstanding)
            
            # Group by facility type
            type_breakdown = {}
            for facility in facilities:
                f_type = facility.facility_type.value
                if f_type not in type_breakdown:
                    type_breakdown[f_type] = {
                        "count": 0,
                        "total_amount": 0,
                        "total_outstanding": 0
                    }
                type_breakdown[f_type]["count"] += 1
                type_breakdown[f_type]["total_amount"] += float(facility.amount) if facility.amount else 0
                type_breakdown[f_type]["total_outstanding"] += float(facility.outstanding) if facility.outstanding else 0
            
            # Encrypt sensitive financial data
            encrypted_totals = {
                "total_amount": self.encryption.encrypt_data(str(total_amount)),
                "total_outstanding": self.encryption.encrypt_data(str(total_outstanding))
            }
            
            return {
                "summary": {
                    "total_facilities": len(facilities),
                    "encrypted_totals": encrypted_totals,
                    "type_breakdown": type_breakdown
                },
                "report_timestamp": datetime.utcnow().isoformat(),
                "data_classification": DataClassification.RESTRICTED.value,
                "encryption_applied": True
            }
            
        except Exception as e:
            logger.error(f"Secure facility report failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Secure facility report generation failed"
            )
    
    def _mask_email(self, email: str) -> str:
        """Mask email address for privacy"""
        if not email or "@" not in email:
            return "***@***.***"
        
        local, domain = email.split("@", 1)
        if len(local) <= 2:
            masked_local = "*" * len(local)
        else:
            masked_local = local[0] + "*" * (len(local) - 2) + local[-1]
        
        domain_parts = domain.split(".")
        if len(domain_parts) >= 2:
            masked_domain = "*" * len(domain_parts[0]) + "." + domain_parts[-1]
        else:
            masked_domain = "***.***"
        
        return f"{masked_local}@{masked_domain}"
    
    def _mask_phone(self, phone: str) -> str:
        """Mask phone number for privacy"""
        if not phone:
            return "***-***-****"
        
        # Remove non-digits
        digits = ''.join(filter(str.isdigit, phone))
        if len(digits) < 4:
            return "*" * len(digits)
        
        # Show last 4 digits only
        return "*" * (len(digits) - 4) + digits[-4:]

class SecureFileHandler:
    """Secure file handling to replace Excel operations"""
    
    def __init__(self, encryption_service: EncryptionService):
        self.encryption = encryption_service
    
    async def create_secure_backup(
        self,
        data: Dict[str, Any],
        backup_type: str,
        user_id: str
    ) -> str:
        """Create encrypted backup of banking data"""
        
        try:
            # Create backup metadata
            backup_metadata = {
                "backup_id": secrets.token_hex(16),
                "backup_type": backup_type,
                "created_by": user_id,
                "created_at": datetime.utcnow().isoformat(),
                "data_classification": DataClassification.RESTRICTED.value,
                "checksum": hashlib.sha256(json.dumps(data, sort_keys=True).encode()).hexdigest()
            }
            
            # Encrypt the entire data payload
            encrypted_data = self.encryption.encrypt_data(json.dumps(data))
            
            # In production, store in secure backup system
            backup_package = {
                "metadata": backup_metadata,
                "encrypted_data": encrypted_data
            }
            
            # Log backup creation
            await AuditLogger.log_access(
                user_id=user_id,
                action="CREATE_BACKUP",
                resource_type="data_backup",
                resource_id=backup_metadata["backup_id"],
                data_classification=DataClassification.RESTRICTED
            )
            
            return backup_metadata["backup_id"]
            
        except Exception as e:
            logger.error(f"Secure backup creation failed: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Secure backup creation failed"
            )

class AccessControlManager:
    """Role-based access control for banking data"""
    
    ROLE_PERMISSIONS = {
        "viewer": ["read"],
        "operator": ["read", "create", "update"],
        "manager": ["read", "create", "update", "delete", "export"],
        "admin": ["read", "create", "update", "delete", "export", "backup", "audit"]
    }
    
    @classmethod
    def check_permission(cls, user_role: str, required_permission: str) -> bool:
        """Check if user role has required permission"""
        user_permissions = cls.ROLE_PERMISSIONS.get(user_role, [])
        return required_permission in user_permissions
    
    @classmethod
    def get_data_access_level(cls, user_role: str) -> DataClassification:
        """Get maximum data classification level for user role"""
        if user_role in ["admin", "manager"]:
            return DataClassification.RESTRICTED
        elif user_role == "operator":
            return DataClassification.CONFIDENTIAL
        else:
            return DataClassification.INTERNAL

# Initialize global services
encryption_service = EncryptionService()