```vba
' OFFER_LETTER_CONTROLLER.xlsm
' Banking Offer Letter Management System
' Author: ALLIN1 Development Team
' Version: 1.0.0

Option Explicit

' Global Variables
Public Const APP_NAME As String = "Offer Letter Controller"
Public Const APP_VERSION As String = "1.0.0"
Public Const API_BASE_URL As String = "http://localhost:8000/api"

' Main Controller Class
Public Type OfferLetterData
    CustomerID As String
    CustomerName As String
    AccountNumber As String
    FacilityType As String
    Amount As Double
    Currency As String
    InterestRate As Double
    Tenor As Integer
    StartDate As Date
    ExpiryDate As Date
    Branch As String
    RelationshipManager As String
    Status As String
    CreatedDate As Date
    LastModified As Date
End Type

' Initialize Application
Sub InitializeApplication()
    On Error GoTo ErrorHandler
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    ' Setup worksheets
    Call SetupWorksheets
    
    ' Load configuration
    Call LoadConfiguration
    
    ' Initialize forms
    Call InitializeForms
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    MsgBox "Offer Letter Controller initialized successfully!", vbInformation, APP_NAME
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    MsgBox "Error initializing application: " & Err.Description, vbCritical, APP_NAME
End Sub

' Setup Required Worksheets
Sub SetupWorksheets()
    On Error Resume Next
    
    Dim ws As Worksheet
    Dim wsNames As Variant
    Dim i As Integer
    
    wsNames = Array("Dashboard", "Customers", "Facilities", "OfferLetters", "Templates", "Config")
    
    For i = 0 To UBound(wsNames)
        Set ws = Nothing
        Set ws = ThisWorkbook.Worksheets(wsNames(i))
        
        If ws Is Nothing Then
            Set ws = ThisWorkbook.Worksheets.Add
            ws.Name = wsNames(i)
            Call SetupWorksheetHeaders(ws, wsNames(i))
        End If
    Next i
    
    ' Set Dashboard as active sheet
    ThisWorkbook.Worksheets("Dashboard").Activate
End Sub

' Setup Worksheet Headers
Sub SetupWorksheetHeaders(ws As Worksheet, sheetType As String)
    On Error GoTo ErrorHandler
    
    ws.Cells.Clear
    
    Select Case sheetType
        Case "Dashboard"
            Call SetupDashboardHeaders(ws)
        Case "Customers"
            Call SetupCustomersHeaders(ws)
        Case "Facilities"
            Call SetupFacilitiesHeaders(ws)
        Case "OfferLetters"
            Call SetupOfferLettersHeaders(ws)
        Case "Templates"
            Call SetupTemplatesHeaders(ws)
        Case "Config"
            Call SetupConfigHeaders(ws)
    End Select
    
    Exit Sub
    
ErrorHandler:
    MsgBox "Error setting up headers for " & sheetType & ": " & Err.Description, vbCritical
End Sub

' Setup Dashboard Headers
Sub SetupDashboardHeaders(ws As Worksheet)
    With ws
        .Range("A1").Value = "OFFER LETTER CONTROLLER DASHBOARD"
        .Range("A1").Font.Size = 16
        .Range("A1").Font.Bold = True
        
        .Range("A3").Value = "Total Customers:"
        .Range("A4").Value = "Active Facilities:"
        .Range("A5").Value = "Pending Offers:"
        .Range("A6").Value = "Last Updated:"
        
        .Range("C3").Value = "=COUNTA(Customers!A:A)-1"
        .Range("C4").Value = "=COUNTIF(Facilities!H:H,""Active"")"
        .Range("C5").Value = "=COUNTIF(OfferLetters!M:M,""Pending"")"
        .Range("C6").Value = "=NOW()"
        
        .Range("A8").Value = "Quick Actions:"
        .Range("A9").Value = "• New Customer"
        .Range("A10").Value = "• New Facility"
        .Range("A11").Value = "• Generate Offer Letter"
        .Range("A12").Value = "• View Reports"
    End With
End Sub

' Setup Customers Headers
Sub SetupCustomersHeaders(ws As Worksheet)
    Dim headers As Variant
    Dim i As Integer
    
    headers = Array("Customer ID", "Customer Name", "Account Number", "Account Type", _
                   "Status", "Email", "Phone", "Branch", "Relationship Manager", _
                   "Created Date", "Last Modified")
    
    With ws
        For i = 0 To UBound(headers)
            .Cells(1, i + 1).Value = headers(i)
            .Cells(1, i + 1).Font.Bold = True
            .Cells(1, i + 1).Interior.Color = RGB(200, 200, 200)
        Next i
        
        .Range("A1:K1").AutoFilter
        .Columns.AutoFit
    End With
End Sub

' Setup Facilities Headers
Sub SetupFacilitiesHeaders(ws As Worksheet)
    Dim headers As Variant
    Dim i As Integer
    
    headers = Array("Facility ID", "Customer ID", "Facility Type", "Amount", _
                   "Currency", "Interest Rate", "Tenor (Months)", "Status", _
                   "Start Date", "Expiry Date", "Created Date", "Last Modified")
    
    With ws
        For i = 0 To UBound(headers)
            .Cells(1, i + 1).Value = headers(i)
            .Cells(1, i + 1).Font.Bold = True
            .Cells(1, i + 1).Interior.Color = RGB(200, 200, 200)
        Next i
        
        .Range("A1:L1").AutoFilter
        .Columns.AutoFit
    End With
End Sub

' Setup Offer Letters Headers
Sub SetupOfferLettersHeaders(ws As Worksheet)
    Dim headers As Variant
    Dim i As Integer
    
    headers = Array("Offer ID", "Customer ID", "Facility ID", "Offer Date", _
                   "Expiry Date", "Amount", "Currency", "Interest Rate", _
                   "Terms", "Template Used", "Generated By", "Approved By", _
                   "Status", "Created Date", "Last Modified")
    
    With ws
        For i = 0 To UBound(headers)
            .Cells(1, i + 1).Value = headers(i)
            .Cells(1, i + 1).Font.Bold = True
            .Cells(1, i + 1).Interior.Color = RGB(200, 200, 200)
        Next i
        
        .Range("A1:O1").AutoFilter
        .Columns.AutoFit
    End With
End Sub

' Setup Templates Headers
Sub SetupTemplatesHeaders(ws As Worksheet)
    Dim headers As Variant
    Dim i As Integer
    
    headers = Array("Template ID", "Template Name", "Facility Type", _
                   "Template Content", "Variables", "Active", "Created Date", "Last Modified")
    
    With ws
        For i = 0 To UBound(headers)
            .Cells(1, i + 1).Value = headers(i)
            .Cells(1, i + 1).Font.Bold = True
            .Cells(1, i + 1).Interior.Color = RGB(200, 200, 200)
        Next i
        
        .Range("A1:H1").AutoFilter
        .Columns.AutoFit
    End With
End Sub

' Setup Configuration Headers
Sub SetupConfigHeaders(ws As Worksheet)
    With ws
        .Range("A1").Value = "Configuration Settings"
        .Range("A1").Font.Size = 14
        .Range("A1").Font.Bold = True
        
        .Range("A3").Value = "Setting"
        .Range("B3").Value = "Value"
        .Range("C3").Value = "Description"
        
        .Range("A3:C3").Font.Bold = True
        .Range("A3:C3").Interior.Color = RGB(200, 200, 200)
        
        .Range("A4").Value = "API_URL"
        .Range("B4").Value = API_BASE_URL
        .Range("C4").Value = "Backend API URL"
        
        .Range("A5").Value = "DEFAULT_CURRENCY"
        .Range("B5").Value = "AED"
        .Range("C5").Value = "Default currency for new facilities"
        
        .Range("A6").Value = "DEFAULT_TENOR"
        .Range("B6").Value = "12"
        .Range("C6").Value = "Default tenor in months"
        
        .Range("A7").Value = "AUTO_SAVE"
        .Range("B7").Value = "TRUE"
        .Range("C7").Value = "Enable auto-save functionality"
    End With
End Sub

' Load Configuration Settings
Sub LoadConfiguration()
    On Error GoTo ErrorHandler
    
    Dim configWs As Worksheet
    Set configWs = ThisWorkbook.Worksheets("Config")
    
    ' Load settings into global variables or registry
    ' Implementation depends on specific requirements
    
    Exit Sub
    
ErrorHandler:
