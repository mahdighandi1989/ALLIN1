End Sub

' Initialize Forms and Controls
Sub InitializeForms()
    On Error Resume Next
    
    ' Initialize any UserForms or ActiveX controls
    ' This is a placeholder for form initialization
    
End Sub

' Customer Management Functions
Function AddCustomer(customerData As OfferLetterData) As Boolean
    On Error GoTo ErrorHandler
    
    Dim ws As Worksheet
    Dim nextRow As Long
    
    Set ws = ThisWorkbook.Worksheets("Customers")
    nextRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    
    With ws
        .Cells(nextRow, 1).Value = GenerateCustomerID()
        .Cells(nextRow, 2).Value = customerData.CustomerName
        .Cells(nextRow, 3).Value = customerData.AccountNumber
        .Cells(nextRow, 4).Value = "Retail" ' Default account type
        .Cells(nextRow, 5).Value = "Active"
        .Cells(nextRow, 6).Value = "" ' Email
        .Cells(nextRow, 7).Value = "" ' Phone
        .Cells(nextRow, 8).Value = customerData.Branch
        .Cells(nextRow, 9).Value = customerData.RelationshipManager
        .Cells(nextRow, 10).Value = Now()
        .Cells(nextRow, 11).Value = Now()
    End With
    
    AddCustomer = True
    Exit Function
    
ErrorHandler:
    AddCustomer = False
    MsgBox "Error adding customer: " & Err.Description, vbCritical
End Function

' Generate unique Customer ID
Function GenerateCustomerID() As String
    Dim ws As Worksheet
    Dim lastRow As Long
    Dim lastID As String
    Dim newNumber As Long
    
    Set ws = ThisWorkbook.Worksheets("Customers")
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    
    If lastRow = 1 Then
        GenerateCustomerID = "C0001"
    Else
        lastID = ws.Cells(lastRow, 1).Value
        newNumber = Val(Right(lastID, 4)) + 1
        GenerateCustomerID = "C" & Format(newNumber, "0000")
    End If
End Function

' Facility Management Functions
Function AddFacility(facilityData As OfferLetterData) As Boolean
    On Error GoTo ErrorHandler
    
    Dim ws As Worksheet
    Dim nextRow As Long
    
    Set ws = ThisWorkbook.Worksheets("Facilities")
    nextRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    
    With ws
        .Cells(nextRow, 1).Value = GenerateFacilityID()
        .Cells(nextRow, 2).Value = facilityData.CustomerID
        .Cells(nextRow, 3).Value = facilityData.FacilityType
        .Cells(nextRow, 4).Value = facilityData.Amount
        .Cells(nextRow, 5).Value = facilityData.Currency
        .Cells(nextRow, 6).Value = facilityData.InterestRate
        .Cells(nextRow, 7).Value = facilityData.Tenor
        .Cells(nextRow, 8).Value = "Active"
        .Cells(nextRow, 9).Value = facilityData.StartDate
        .Cells(nextRow, 10).Value = facilityData.ExpiryDate
        .Cells(nextRow, 11).Value = Now()
        .Cells(nextRow, 12).Value = Now()
    End With
    
    AddFacility = True
    Exit Function
    
ErrorHandler:
    AddFacility = False
    MsgBox "Error adding facility: " & Err.Description, vbCritical
End Function

' Generate unique Facility ID
Function GenerateFacilityID() As String
    Dim ws As Worksheet
    Dim lastRow As Long
    Dim lastID As String
    Dim newNumber As Long
    
    Set ws = ThisWorkbook.Worksheets("Facilities")
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    
    If lastRow = 1 Then
        GenerateFacilityID = "F0001"
    Else
        lastID = ws.Cells(lastRow, 1).Value
        newNumber = Val(Right(lastID, 4)) + 1
        GenerateFacilityID = "F" & Format(newNumber, "0000")
    End If
End Function

' Offer Letter Generation
Function GenerateOfferLetter(customerID As String, facilityID As String) As Boolean
    On Error GoTo ErrorHandler
    
    Dim customerData As OfferLetterData
    Dim facilityData As OfferLetterData
    Dim templateContent As String
    
    ' Get customer and facility data
    If Not GetCustomerData(customerID, customerData) Then
        MsgBox "Customer not found!", vbCritical
        GenerateOfferLetter = False
        Exit Function
    End If
    
    If Not GetFacilityData(facilityID, facilityData) Then
        MsgBox "Facility not found!", vbCritical
        GenerateOfferLetter = False
        Exit Function
    End If
    
    ' Get template
    templateContent = GetTemplate(facilityData.FacilityType)
    If templateContent = "" Then
        MsgBox "Template not found for facility type: " & facilityData.FacilityType, vbCritical
        GenerateOfferLetter = False
        Exit Function
    End If
    
    ' Generate offer letter
    Dim offerContent As String
    offerContent = ProcessTemplate(templateContent, customerData, facilityData)
    
    ' Save offer letter
    If SaveOfferLetter(customerID, facilityID, offerContent) Then
        GenerateOfferLetter = True
        MsgBox "Offer letter generated successfully!", vbInformation
    Else
        GenerateOfferLetter = False
    End If
    
    Exit Function
    
ErrorHandler:
    GenerateOfferLetter = False
    MsgBox "Error generating offer letter: " & Err.Description, vbCritical
End Function

