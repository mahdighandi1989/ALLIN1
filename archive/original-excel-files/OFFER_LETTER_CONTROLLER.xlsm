```python
"""
OFFER LETTER CONTROLLER - Secure Database Migration
Replaces Excel-based OFFER_LETTER_CONTROLLER.xlsm with secure database solution
"""
from datetime import datetime, date
from typing import Optional, List, Dict, Any
from sqlalchemy import Column, String, Boolean, DateTime, Date, Text, Numeric, ForeignKey, Enum as SQLEnum
from sqlalchemy.orm import relationship
from sqlalchemy.sql import func
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, update, and_, or_
from fastapi import APIRouter, Depends, HTTPException, status, Query
from pydantic import BaseModel, Field, validator
import uuid
import enum
from decimal import Decimal

from app.database import Base, get_db
from app.utils.security import get_current_user, TokenData
from app.models.customer import Customer


def generate_offer_id():
    """Generate secure offer letter ID"""
    return "OL" + str(uuid.uuid4())[:6].upper()


class OfferStatus(str, enum.Enum):
    DRAFT = "draft"
    PENDING_APPROVAL = "pending_approval"
    APPROVED = "approved"
    ISSUED = "issued"
    ACCEPTED = "accepted"
    REJECTED = "rejected"
    EXPIRED = "expired"
    CANCELLED = "cancelled"


class OfferType(str, enum.Enum):
    LOAN = "loan"
    OVERDRAFT = "overdraft"
    CREDIT_CARD = "credit_card"
    LC = "lc"
    LG = "lg"
    TRADE_FINANCE = "trade_finance"
    MORTGAGE = "mortgage"
    PERSONAL_LOAN = "personal_loan"
    BUSINESS_LOAN = "business_loan"


class CurrencyCode(str, enum.Enum):
    AED = "AED"
    USD = "USD"
    EUR = "EUR"
    GBP = "GBP"
    SAR = "SAR"


class OfferLetter(Base):
    """
    Secure database model for offer letters
    Replaces Excel-based storage with encrypted database solution
    """
    __tablename__ = "offer_letters"

    # Primary identification
    id = Column(String(8), primary_key=True, default=generate_offer_id)
    offer_number = Column(String(50), unique=True, nullable=False, index=True)
    customer_id = Column(String(8), ForeignKey("customers.id"), nullable=False, index=True)
    
    # Offer details
    offer_type = Column(SQLEnum(OfferType), nullable=False)
    status = Column(SQLEnum(OfferStatus), default=OfferStatus.DRAFT)
    
    # Financial terms - encrypted in production
    principal_amount = Column(Numeric(18, 2), nullable=False)
    currency = Column(SQLEnum(CurrencyCode), default=CurrencyCode.AED)
    interest_rate = Column(Numeric(5, 4))  # Supports up to 99.9999%
    tenor_months = Column(String(20))
    
    # Dates with validation
    offer_date = Column(Date, nullable=False, default=func.current_date())
    validity_date = Column(Date, nullable=False)
    proposed_disbursement_date = Column(Date)
    
    # Security and compliance
    security_details = Column(Text)  # Encrypted field
    collateral_description = Column(Text)
    guarantee_details = Column(Text)
    
    # Terms and conditions
    terms_conditions = Column(Text, nullable=False)
    special_conditions = Column(Text)
    covenants = Column(Text)
    
    # Processing information
    prepared_by = Column(String(100), nullable=False)
    reviewed_by = Column(String(100))
    approved_by = Column(String(100))
    branch_code = Column(String(20))
    department = Column(String(100))
    
    # Customer response
    customer_response = Column(SQLEnum(OfferStatus))
    response_date = Column(Date)
    response_notes = Column(Text)
    
    # Document management
    document_path = Column(String(500))  # Secure file storage path
    template_version = Column(String(20), default="1.0")
    
    # Audit trail
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())
    is_deleted = Column(Boolean, default=False)
    
    # Relationships
    customer = relationship("Customer", back_populates="offer_letters")


# Add relationship to Customer model
Customer.offer_letters = relationship("OfferLetter", back_populates="customer")


# Pydantic schemas for API
class OfferLetterBase(BaseModel):
    """Base schema for offer letter data"""
    offer_number: str = Field(..., min_length=1, max_length=50)
    customer_id: str = Field(..., min_length=2, max_length=8)
    offer_type: OfferType
    principal_amount: Decimal = Field(..., gt=0, decimal_places=2)
    currency: CurrencyCode = CurrencyCode.AED
    interest_rate: Optional[Decimal] = Field(None, ge=0, le=100, decimal_places=4)
    tenor_months: Optional[str] = None
    validity_date: date
    proposed_disbursement_date: Optional[date] = None
    security_details: Optional[str] = None
    collateral_description: Optional[str] = None
    guarantee_details: Optional[str] = None
    terms_conditions: str = Field(..., min_length=10)
    special_conditions: Optional[str] = None
    covenants: Optional[str] = None
    branch_code: Optional[str] = None
    department: Optional[str] = None

    @validator('validity_date')
    def validate_validity_date(cls, v):
        if v <= date.today():
            raise ValueError('Validity date must be in the future')
        return v

    @validator('proposed_disbursement_date')
    def validate_disbursement_date(cls, v, values):
        if v and 'validity_date' in values and v > values['validity_date']:
            raise ValueError('Disbursement date cannot be after validity date')
        return v


class OfferLetterCreate(OfferLetterBase):
    """Schema for creating new offer letter"""
    pass


class OfferLetterUpdate(BaseModel):
    """Schema for updating offer letter"""
    offer_type: Optional[OfferType] = None
    status: Optional[OfferStatus] = None
    principal_amount: Optional[Decimal] = Field(None, gt=0, decimal_places=2)
    currency: Optional[CurrencyCode] = None
    interest_rate: Optional[Decimal] = Field(None, ge=0, le=100, decimal_places=4)
    tenor_months: Optional[str] = None
    validity_date: Optional[date] = None
    proposed_disbursement_date: Optional[date] = None
    security_details: Optional[str] = None
    collateral_description: Optional[str] = None
    guarantee_details: Optional[str] = None
    terms_conditions: Optional[str] = None
    special_conditions: Optional[str] = None
    covenants: Optional[str] = None
    reviewed_by: Optional[str] = None
    approved_by: Optional[str] = None


class OfferLetterResponse(OfferLetterBase):
    """Schema for offer letter response"""
    id: str
    status: OfferStatus
    offer_date: date
    prepared_by: str
    reviewed_by: Optional[str]
    approved_by: Optional[str]
    customer_response: Optional[OfferStatus]
    response_date: Optional[date]
    response_notes: Optional[str]
    template_version: str
    created_at: datetime
    updated_at: Optional[datetime]
    
    # Customer information
    customer_name: Optional[str] = None
    customer_account_no: Optional[str] = None
    
    class Config:
        from_attributes = True


class CustomerResponseUpdate(BaseModel):
    """Schema for customer response to offer"""
    customer_response: OfferStatus = Field(..., description="Customer's response to the offer")
    response_notes: Optional[str] = Field(None, max_length=1000)
    
    @validator('customer_response')
    def validate_customer_response(cls, v):
        allowed_responses = [OfferStatus.ACCEPTED, OfferStatus.REJECTED]
        if v not in allowed_responses:
            raise ValueError('Customer response must be either ACCEPTED or REJECTED')
        return v


# API Router
router = APIRouter(prefix="/api/offer-letters", tags=["Offer Letters"])


@router.post("/", response_model=OfferLetterResponse, status_code=status.HTTP_201_CREATED)
async def create_offer_letter(
    offer_data: OfferLetterCreate,
    db: AsyncSession = Depends(get_db),
    current_user: TokenData = Depends(get_current_user)
):
    """Create a new offer letter with security validation"""
    try:
        # Verify customer exists and is active
        customer_query = select(Customer).where(
            and_(
                Customer.id == offer_data.customer_id,
                Customer.is_deleted == False,
                Customer.status == "active"
            )
        )
        customer_result = await db.execute(customer_query)
        customer = customer_result.scalar_one_or_none()
        
        if not customer:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Active customer not found"
            )
        
        # Check for duplicate offer number
        existing_query = select(OfferLetter).where(
            and_(
                OfferLetter.offer_number == offer_data.offer_number,
                OfferLetter.is_deleted == False
            )
        )
        existing_result = await db.execute(existing_query)
        if existing_result.scalar_one_or_none():
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Offer number already exists"
            )
        
        # Create new offer letter
        db_offer = OfferLetter(
            **offer_data.model_dump(),
            prepared_by=current_user.username,
            status=OfferStatus.DRAFT,
            offer_date=date.today()
        )
        
        db.add(db_offer)
        await db.commit()
        await db.refresh(db_offer)
        
        # Add customer information to response
        response_data = OfferLetterResponse.from_orm(db_offer)
        response_data.customer_name = customer.name
        response_data.customer_account_no = customer.account_no
        
        return response_data
        
    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to create offer letter: {str(e)}"
        )


@router.get("/", response_model=Dict[str, Any])
async def get_offer_letters(
    skip: int = Query(0, ge=0),
    limit: int = Query(100, ge=1, le=1000),
    customer_id: Optional[str] = Query(None),
    status: Optional[OfferStatus] = Query(None),
    offer_type: Optional[OfferType] = Query(None),
    search: Optional[str] = Query(None),
    db: AsyncSession = Depends(get_db),
    current_user: TokenData = Depends(get_current_user)
):
    """Get offer letters with advanced filtering"""
    try:
        # Build base query
        query = select(OfferLetter).where(OfferLetter.is_deleted == False)
        count_query = select(func.count()).select_from(OfferLetter).where(OfferLetter.is_deleted == False)
        
        # Apply filters
        filters = []
        
        if customer_id:
            filters.append(OfferLetter.customer_id == customer_id)
        
        if status:
            filters.append(OfferLetter.status == status)
        
        if offer_type:
            filters.append(OfferLetter.offer_type == offer_type)
        
        if search:
            search_filter = f"%{search.strip()}%"
            filters.append(
                or_(
                    OfferLetter.offer_number.ilike(search_filter),
                    OfferLetter.terms_conditions.ilike(search_filter)
                )
            )
        
        if filters:
            filter_condition = and_(*filters)
            query = query.where(filter_condition)
            count_query = count_query.where(filter_condition)
        
        # Get total count
        total_result = await db.execute(count_query)
        total = total_result.scalar() or 0
        
        # Apply pagination and ordering
        query = query.order_by(OfferLetter.created_at.desc()).offset(skip).limit(limit)
        
        # Execute query
        result = await db.execute(query)
        offers = result.scalars().all()
        
        # Get customer information
        customer_ids = list(set(o.customer_id for o in offers))
        customer_info = {}
        if customer_ids:
            customers_query = select(Customer).where(Customer.id.in_(customer_ids))
            customers_result = await db.execute(customers_query)
            for customer in customers_result.scalars():
                customer_info[customer.id] = {
                    "name": customer.name,
                    "account_no": customer.account_no
                }
        
        # Prepare response with customer information
        offer_responses = []
        for offer in offers:
            offer_dict = offer.__dict__.copy()
            if offer.customer_id in customer_info:
                offer_dict['customer_name'] = customer_info[offer.customer_id]['name']
                offer_dict['customer_account_no'] = customer_info[offer.customer_id]['account_no']
            offer_responses.append(offer_dict)
        
        return {
            "items": offer_responses,
            "total": total,
            "page": (skip // limit) + 1 if limit > 0 else 1,
            "page_size": limit,
            "pages": (total + limit - 1) // limit if limit > 0 else 1
        }
        
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to retrieve offer letters: {str(e)}"
        )


