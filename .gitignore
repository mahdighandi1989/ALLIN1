# supervisor run artefacts (regenerated every run; the reports that matter are committed)
docs/supervisor/last_server.log
docs/supervisor/last_run.log
scripts/supervisor/__pycache__/

# Supervisor scratch databases — the auditor and the runtime sweep each open a
# throwaway SQLite file next to the backend; they are rebuilt on every run and
# must never be committed (they would also leak whatever was seeded into them).
# v156 — any scratch SQLite a local run leaves behind. One was staged by
# `git add -A` after checking the page in a browser; it is a database, not source.
# v158 — the disk FALLBACK store for inspection attachments. These are uploaded
# files (the owner's samples, and whatever a test run puts there); they belong in
# Drive or on the instance's disk, never in the repository. Seven test artefacts
# were committed by `git add -A` before this line existed.
backend/storage/
backend/_*.db
backend/_*.db-wal
backend/_*.db-shm
backend/_supervisor_audit.db
backend/_supervisor_run.db
backend/_sup_inv.db
backend/_supervisor_*.db-wal
backend/_supervisor_*.db-shm
docs/supervisor/last_run.log
docs/supervisor/last_server.log

# Supervisor inspection working copy — rebuilt by `inspection.py pull` on every
# round. Only the README is tracked (the sheets themselves live in the API).
docs/supervisor/inspection/QUEUE.md
# v156 — the urgent brief was MISSED when v155 added it. It carries whatever the
# owner put on the sheet: customer names, account numbers, national IDs. One
# `git add -A` would have committed that into the repository's history.
docs/supervisor/inspection/URGENT.md
docs/supervisor/inspection/shots/
# v146 — the owner's attached samples, pulled as text on every run. Working
# copies of material that lives in Drive; never the record itself.
docs/supervisor/inspection/files/

# local probe/verification database (v172 — never commit a DB)
backend/_probe.db
backend/qc_test.db
