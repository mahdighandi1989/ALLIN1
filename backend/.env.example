# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/allin1_banking

# JWT Secret - CRITICAL: Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Debug mode
DEBUG=false

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Application Settings
APP_NAME=ALLIN1 Banking Operations
APP_VERSION=3.0.0

# Database Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Production Security Headers
SECURE_COOKIES=true
HTTPS_ONLY=true
CSRF_PROTECTION=true

# API Settings
API_PREFIX=/api
API_TIMEOUT=30

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx

# Backup Settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false
HEALTH_CHECK_INTERVAL=60

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Environment
ENVIRONMENT=development