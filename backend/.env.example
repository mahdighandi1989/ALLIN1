# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/allin1_banking

# JWT Secret - CRITICAL: Generate a strong key with: openssl rand -base64 48
# Read from SECRET_KEY (or its alias JWT_SECRET_KEY). Must be >= 32 chars.
# In ENVIRONMENT=production the app REFUSES to start with a weak/placeholder key.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32
# JWT signing algorithm. The insecure 'none' algorithm is rejected and must
# never be used. Allowed: HS256/384/512, RS256/384/512, ES256/384/512, PS*.
ALGORITHM=HS256
# NOTE: the access-token lifetime is configured in code (config.Settings,
# default 7 days) and is intentionally NOT exposed as a deployment env var —
# the previous access-token-expiry entry here was never read by any
# os.getenv()/process.env reader and has been removed to avoid a misleading,
# no-op knob. Change the lifetime in backend/app/config.py if needed.

# Debug mode
DEBUG=false

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
# Login brute-force protection: throttle (HTTP 429) after N failures/minute and
# lock the account (HTTP 423) for ACCOUNT_LOCKOUT_MINUTES after the threshold.
LOGIN_RATE_LIMIT_PER_MINUTE=5
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=30
# Force HTTP->HTTPS redirect + HSTS. Leave unset to auto-enable in production.
# FORCE_HTTPS=true

# Application Settings
APP_NAME=ALLIN1 Banking Operations
APP_VERSION=3.0.0

# Database Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# Telegram integration (optional — two-way notifications + bot control)
# Create a bot with @BotFather to get the token. TELEGRAM_CHAT_ID is a
# comma-separated allow-list of chat ids that may receive notifications and
# drive the bot; the first id is the default notification target. To find a
# chat id, message the bot once before any id is set and it replies with it.
# TELEGRAM_WEBHOOK_SECRET is a shared secret echoed by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header; set it in production to reject forged
# webhook calls. The webhook is auto-configured at startup when BACKEND_PUBLIC_URL
# (or RENDER_EXTERNAL_URL) is known; otherwise set it from Settings → Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# BACKEND_PUBLIC_URL=https://your-backend.example.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Production Security Headers
SECURE_COOKIES=true
HTTPS_ONLY=true
CSRF_PROTECTION=true

# API Settings
API_PREFIX=/api
API_TIMEOUT=30

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx

# Backup Settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false
HEALTH_CHECK_INTERVAL=60

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Google Sign-In (OAuth 2.0) — powers the "Login with Google" button on the
# sign-in page. Create an OAuth client (type "Web application") in the Google
# Cloud console and register the callback below as an Authorized redirect URI.
# Leave these blank to disable the Google button (the app keeps username/password
# login). google_oauth_configured() requires all three to be set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# SPA route the backend redirects to after a successful Google login (it reads
# the issued JWT from the query string).
POST_LOGIN_REDIRECT_PATH=/auth/callback

# Google Drive sync — automated mirroring of DB snapshots + document attachments
# into Google Drive so large files don't bloat the DB/ephemeral disk.
#
# Two auth modes (GOOGLE_DRIVE_AUTH_MODE):
#   • "oauth" (DEFAULT, recommended) — syncs as a real Google user via an OAuth
#     refresh token, reusing GOOGLE_CLIENT_ID/SECRET (the same ones as Google
#     Sign-In). Files are owned by that user and use their personal 15 GB quota,
#     so it WORKS WITH A NORMAL GMAIL ACCOUNT. Setup: set GOOGLE_DRIVE_ENABLED=true,
#     then click "Connect Google Drive" in the panel Settings (one-time consent).
#     The app creates/uses its own folder (DRIVE_BACKUP_FOLDER) in your My Drive —
#     GOOGLE_DRIVE_FOLDER_ID / GOOGLE_CREDENTIALS_JSON are NOT used.
#   • "service_account" — server-to-server via GOOGLE_CREDENTIALS_JSON. NOTE: a
#     Service Account has no storage quota of its own, so this ONLY works with a
#     Google Workspace *Shared Drive* (uploading to a personal My Drive folder
#     fails with 403 storageQuotaExceeded). Share the Shared Drive folder with the
#     Service Account's client_email and put its id in GOOGLE_DRIVE_FOLDER_ID.
#
# When disabled/unconfigured every sync is a graceful no-op.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=oauth
# Only used in service_account mode:
GOOGLE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# How often the background DB-snapshot sync runs (attachments sync immediately).
DRIVE_SYNC_INTERVAL_HOURS=24

# Environment
ENVIRONMENT=development

# ⚠️ TEMPORARY: login/auth toggle. When true the login requirement is bypassed
# (every request runs as a shared "demo" user and the frontend skips the login
# screen). Currently defaults to true so the app is usable without logging in.
# Set to false to restore mandatory authentication (no frontend rebuild needed —
# it adapts at runtime via GET /api/auth/config).
AUTH_DISABLED=true

# Bootstrap admin account, created at startup when the users table is empty so
# the app is loginable as soon as you set AUTH_DISABLED=false. CHANGE THESE.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345
DEFAULT_ADMIN_EMAIL=admin@allin1.local